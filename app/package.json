{
  "name": "davbar-keg-display",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d",
  "description": "The upload and preview web-app for the DavBar Keg Display project",
  "main": "index.js",
  "type": "module",
  "author": "ChromeQ",
  "scripts": {
    "build": "pnpm --dir web build",
    "compile": "pnpm -r --parallel --aggregate-output run compile",
    "dev": "pnpm --dir web dev",
    "device:build": "tsx scripts/device.ts build",
    "device:upload": "tsx scripts/device.ts upload",
    "device:upload:fs": "tsx scripts/device.ts upload-fs",
    "lint": "pnpm -r --parallel --aggregate-output run lint",
    "outdated": "pnpm -r --parallel --aggregate-output run outdated",
    "preview": "pnpm --dir web preview",
    "test": "pnpm -r --parallel --aggregate-output run test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jiti": "2.7.0",
    "tsx": "catalog:",
    "typescript": "catalog:typescript",
    "@typescript/native": "catalog:typescript"
  }
}
