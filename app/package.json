{
  "name": "davbar-keg-display",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "description": "The upload and preview web-app for the DavBar Keg Display project",
  "main": "index.js",
  "type": "module",
  "author": "ChromeQ",
  "scripts": {
    "build": "pnpm --dir web build",
    "compile": "pnpm -r --parallel --aggregate-output run compile",
    "dev": "pnpm --dir web dev",
    "device:build": "tsx scripts/device.ts build",
    "device:upload": "tsx scripts/device.ts upload",
    "device:upload:fs": "tsx scripts/device.ts upload-fs",
    "lint": "eslint . && pnpm -r --parallel --aggregate-output run lint",
    "lint:fix": "eslint --fix . && pnpm -r --parallel --aggregate-output run lint:fix",
    "outdated": "pnpm -r --parallel --aggregate-output run outdated",
    "preview": "pnpm --dir web preview",
    "strip:glyphs": "tsx scripts/strip-glyphs.ts",
    "test": "pnpm -r --parallel --aggregate-output run test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@fontsource/roboto": "5.3.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:typescript",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "fontkit": "2.0.4",
    "globals": "catalog:",
    "jiti": "2.7.0",
    "prettier": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:typescript",
    "typescript-eslint": "catalog:"
  }
}
